{
  "name": "llmscout-cli",
  "version": "0.3.8",
  "description": "Cross-platform LLM/GEO/AEO checker CLI in TypeScript. 21 technical-SEO and generative-engine-optimization checks, two runtime dependencies (cheerio, commander), no Python interpreter or headless browser required.",
  "keywords": [
    "llm",
    "geo",
    "aeo",
    "seo",
    "generative-engine-optimization",
    "answer-engine-optimization",
    "ai-seo",
    "llms-txt",
    "technical-seo",
    "cli",
    "typescript",
    "cross-platform",
    "ai-visibility",
    "llm-optimization",
    "chatgpt",
    "perplexity",
    "claude",
    "google-ai-overviews",
    "claude-code",
    "agent-native"
  ],
  "homepage": "https://github.com/RudrenduPaul/LLMScout#readme",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/LLMScout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/LLMScout.git"
  },
  "license": "MIT",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "type": "module",
  "bin": {
    "llmscout": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^13.1.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "undici": "^7.29.0"
  }
}
